# package.json IS committed as of 2026-08-29 — scripts only, still zero
# dependencies (see docs/superpowers/specs/2026-08-29-cloudflare-migration-design.md,
# decision 9). It was ignored before because the only reason to have one was a
# throwaway `npm i playwright --no-save` for the sweep harness. The lock file
# stays ignored: with no dependencies there should never be one to commit.
package-lock.json
# sweep screenshots + report are regenerable artifacts — keep run-sweep.mjs, drop output
tests/sweep/**/*.png
tests/sweep/report.json
tests/sweep/report.md
# full real-click E2E harness output (screenshots + reports) — regenerable
tests/e2e/out/
tests/e2e/node_modules/
# E2E v2 harness output (screenshots + report) — regenerable, keep the .mjs source
tests/e2e/v2/screenshots/
tests/e2e/v2/report.json
# scratch dev/verification scripts (underscore-prefixed) — kept local, not product
scripts/_*.mjs
# mascots/ committed for preview — will move to R2 once Worker is built
# visual-sweep screenshots — regenerable
tests/e2e/v2/visual/

# staged copy uploaded to Cloudflare Pages — regenerable, never committed
.publish/

# verification evidence — screenshots of a child using the app. NEVER committed.
docs/verify/shots/

# Codex review scratch files — local only, never committed. This rule lived in
# .git/info/exclude, which is per-machine: a fresh clone of this PUBLIC repo would
# not have ignored them and a stray `git add .` would have published a raw audit.
CODEX-NOTES.md
CODEX-TASKS.md

# per-run staging folders made by tests — regenerable, never committed
.publish-test-*/
